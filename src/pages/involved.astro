---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout infoKey="shainas-garden" title="Get Involved" heroImg="https://ik.imagekit.io/thegoldendino/rvcd/hero/shainas-garden_beNTfr3UppdB.jpg?updatedAt=1636006417641&tr=w-1024,f-jpg,pr-true" bg="bg-mustard/80">
	<div class="flex flex-wrap md:flex-no-wrap">
		<div class="md:w-1/3 md:flex-none mb-8 px-4 rounded-xl mt-3">
			<h3 class="text-gray-200 text-2xl mt-4 mb-2 bg-mustard relative right-2 px-4 py-2"
				>Take part in the planning of your
				Creative District!
			</h3>
				<p class="text-gray-600 text-xl leading-relaxed">
				All are welcome to attend monthly meetings:
				<br/>
				2nd Tuesdays, 6-7:30pm over Zoom.
				<br/><br/>
				<a href="mailto:rvcdinfo@gmail.com" class="font-semibold">rvcdinfo@gmail.com</a> for info and meeting link.</p>

			<div class="mt-10 pt-8 border-t border-gray-400/40">
				<a
					class="text-center block text-gray-200 rounded-xl py-2 px-4 mb-4 bg-mustard hover:opacity-80 focus:scale-95"
					href="https://docs.google.com/forms/d/e/1FAIpQLSdqDWQEM92r0Pi7Z4HL5CmMREkmuAs-D44JYKIs3gztJG818w/viewform"
					target="_blank"
					rel="noopener noreferrer"
				>
					<span class="block text-2xl font-semibold">Join Our Vendor Network</span
					>
				</a>
				<p class="text-gray-600 text-xl leading-relaxed">
				<a href="https://docs.google.com/forms/d/e/1FAIpQLSdqDWQEM92r0Pi7Z4HL5CmMREkmuAs-D44JYKIs3gztJG818w/viewform" target="_blank" rel="noopener noreferrer" class="font-semibold underline">Connect</a> local businesses, artists, food vendors, service providers, and community organizations with event organizers throughout Rainier Valley.</p>
			</div>
		</div>
		<div class="flex-grow">
			<iframe 
				src="https://docs.google.com/forms/d/e/1FAIpQLSff-6e7EgFkrRUbNN8DmiVPelswI6eREVVwzE-7Dgm_GwjfUQ/viewform?embedded=true" 
				width="100%" 
				height="1170" 
				frameborder="0" 
				marginheight="0" 
				marginwidth="0">
				Loading…
			</iframe>
		</div>
	</div> 
</MainLayout>